# Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id

# Set true only after enabling Server Members Intent and Guild Invites Intent
# in the Discord Developer Portal.
ENABLE_TRACKING_INTENTS=false
GUILD_ID=your_server_id

# The server role and optional log channel are configured with /setup-verification.
